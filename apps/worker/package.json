    "@langchain/langgraph": "^1.0.0",
    "@realty/core": "workspace:*",
    "@realty/db": "workspace:*",
    "@realty/ingestion": "workspace:*",
    "@realty/monitoring": "workspace:*",
    "pg-boss": "^12.26.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
